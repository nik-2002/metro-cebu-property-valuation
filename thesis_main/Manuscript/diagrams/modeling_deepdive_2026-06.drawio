<mxfile host="app.diagrams.net" modified="2026-06-13T00:00:00.000Z" agent="claude" version="24.0.0">
  <diagram name="Modeling Deep Dive" id="deepdive-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Modeling Deep Dive — Feature sets · Leak-free tuning · RF vs XGBoost · the three research questions it answers" style="text;html=1;align=center;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1420" height="30" as="geometry" />
        </mxCell>

        <!-- Input strata -->
        <mxCell id="strata" value="STRATIFIED INPUT (prepare_stratified_abt.py)&#10;Condo 687  ·  Houses 674  ·  Lot 255&#10;TARGET = log_price = log(price_per_sqm)   →   predict per-sqm, exp() back, × area = total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#d79b00;align=center;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="55" width="640" height="70" as="geometry" />
        </mxCell>

        <!-- Feature sets split -->
        <mxCell id="fs_title" value="FEATURE SETS DIFFER BY MODEL (run_models_stratified.build_features)" style="text;html=1;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="1420" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ols_feats" value="OLS / HEDONIC  — X_ols (trimmed)&#10;&#10;• structural: log_area_sqm (log-log spec), bedrooms, bathrooms, imputed flags&#10;• city dummies, property_type dummies&#10;• TOP-2 CBD distances per stratum only&#10;• bir_zonal_rr_log (drops raw bir_zonal_rr_median)&#10;• MCRAI individual cats + spatial_lag_price&#10;• DROPS mcrai_composite (VIF ~1e11)&#10;&#10;HC3 robust SE · interpretable coefficients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="175" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="tree_feats" value="RANDOM FOREST &amp; XGBOOST — X_full (complete)&#10;&#10;• structural: raw area_sqm, bedrooms, bathrooms, imputed flags&#10;• city dummies, property_type dummies&#10;• ALL 8 CBD network distances&#10;• road distances (trunk, primary)&#10;• ALL 8 MCRAI categories + mcrai_composite&#10;• bir_zonal_rr_median + bir_zonal_rr_log + bir_zonal_cr_median&#10;• spatial_lag_price&#10;&#10;trees handle correlated / non-linear features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1040" y="175" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- Central harness -->
        <mxCell id="harness" value="LEAK-FREE EVALUATION HARNESS (finalize_stratified_groupcv.py)&#10;&#10;group_oof() over GroupKFold(5)&#10;groups = coordinate cluster:  df.groupby([latitude, longitude]).ngroup()&#10;→ relistings &amp; same-pin (barangay-centroid) rows never straddle folds&#10;&#10;iaao_panel(): MdAPE · PE20 · MAPE · COD · PRD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="195" width="540" height="180" as="geometry" />
        </mxCell>

        <!-- Tuning -->
        <mxCell id="rf_tune" value="RF TUNING (deployed): 24-setting grid&#10;n_estimators (300,400) × max_features (0.7,0.9,1.0) × min_samples_leaf (1,2) × max_depth (None,20)&#10;→ pick lowest group-CV MdAPE&#10;Best: Condo(400,0.9,2,None) · Houses(300,1.0,2,20) · Lot(400,1.0,1,None)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="400" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="xgb_tune" value="XGB TUNING (comparator, answer_rq2_rq3.py): small grid&#10;n_estimators (300,500) × max_depth (3,5) × learning_rate (0.05,0.1) × subsample 0.9&#10;→ same GroupKFold folds, same MdAPE scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="490" width="540" height="65" as="geometry" />
        </mxCell>

        <!-- RQ2 output -->
        <mxCell id="rq2box" value="RQ2 — FAIR HEAD-TO-HEAD&#10;model_comparison_groupcv.csv&#10;&#10;OLS vs RF vs XGB, all under the SAME GroupKFold.&#10;RF metrics must match the manifest (sanity check).&#10;Deployed RF (leak-free):&#10;Condo 20.1% · Houses 22.1% · Lot 25.6% MdAPE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="430" height="150" as="geometry" />
        </mxCell>

        <!-- RQ3 output -->
        <mxCell id="rq3box" value="RQ3 — GEOSPATIAL ABLATION&#10;ablation_groupcv.csv&#10;&#10;Same RF, same folds, 3 nested tiers:&#10;Tier 1 Structural (area, beds, baths, type)&#10;Tier 2 + Admin location (city dummies, BIR)&#10;Tier 3 + Engineered geospatial (CBD, MCRAI,&#10;road, spatial_lag)&#10;Report ΔMdAPE / ΔPE20 uplift (Tier2→Tier3 = pure&#10;geospatial value). Honest even if no uplift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="535" y="600" width="430" height="150" as="geometry" />
        </mxCell>

        <!-- Why RF + verdict -->
        <mxCell id="whyrf" value="WHY RANDOM FOREST (the honest answer — RF ≈ XGB)&#10;&#10;Head-to-head MdAPE: Condo RF 20.1 / XGB 21.4 · Houses 22.1 / 22.2 · Lot 25.6 / 24.3.&#10;Tree models beat OLS everywhere; RF and XGB tie (within ~1.3pp = noise on 255–687 rows).&#10;Deploy RF NOT for accuracy but for: small-sample robustness (bagging) · fewer knobs ·&#10;deterministic, scikit-learn-only deployment.&#10;&#10;VERDICT:  RF = DEPLOYED (parsimony)   ·   XGB = equivalent comparator   ·   OLS = transparent diagnostic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;fontSize=10;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="990" y="600" width="430" height="150" as="geometry" />
        </mxCell>

        <!-- RQ4 -->
        <mxCell id="rq4box" value="RQ4 — VALUATION GAP (answer_rq4.py) — uses the deployed RF's leak-free out-of-fold predictions:  model_gap = pred_price_per_sqm − bir_zonal_rr_median, summarised by LGU × stratum  →  valuation_gap_summary.csv + QGIS/data/valuation_gap.geojson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="785" width="1340" height="60" as="geometry" />
        </mxCell>

        <!-- arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="strata" target="harness">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="ols_feats" target="harness">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="tree_feats" target="harness">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="rf_tune" target="rq2box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="xgb_tune" target="rq3box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="rq2box" target="rq4box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
