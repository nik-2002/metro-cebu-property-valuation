                <mxCell id="s7_streamlit" value="&lt;b&gt;Streamlit Web App&lt;/b&gt;&lt;br&gt;&lt;font&gt;thesis_main/app/&lt;br&gt;Property Predictor (price_per_sqm + SHAP waterfall)&lt;br&gt;Predicted Price Surface (open_market)&lt;br&gt;Deployed model: rf_model.pkl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3e6;strokeColor=#2d7d46;shadow=1;fontSize=12;arcSize=15;strokeWidth=2;" parent="1" vertex="1">
